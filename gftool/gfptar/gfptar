    def cmd_list0(self, outf, indir, verbose):
        self.options_init()
        quiet = self.quiet
        indir_url = GfURL.init(indir)

        def print_quiet(serial, gen, path, fattr):
            pass

        def print_verbose(serial, gen, path, fattr):
            name = path
            if fattr.ftype == InfoDB.TYPE_DIR:
                name = name + '/'
            elif fattr.ftype == InfoDB.TYPE_SYMLINK:
                name = name + ' -> ' + fattr.linkname
            dt_object = datetime.datetime.fromtimestamp(fattr.mtime)
            mtime_str = dt_object.strftime('%Y-%m-%d %H:%M')
            outf.write('g%d_%04d %s %04o %8s/%-8s %9d %s %s\n' % (
                gen, serial, fattr.ftype, fattr.mode, fattr.user,
                fattr.group, fattr.size, mtime_str, name))

        def print_simple(serial, gen, path, fattr):
            if fattr.ftype == InfoDB.TYPE_DIR:
                print(f"{fattr.ftype} {path}/", file=outf)
            else:
                print(f"{fattr.ftype} {path}", file=outf)

        if quiet:
            print_func = print_quiet
            resolve_ugmap = False
        elif verbose:
            print_func = print_verbose
            resolve_ugmap = True
        else:
            print_func = print_simple
            resolve_ugmap = False

        count = 0
        for serial, gen, ent_path, fattr in self.list_entries(
                indir_url, resolve_ugmap=resolve_ugmap):
            if self.is_canceled():
                break
            print_func(serial, gen, ent_path, fattr)
            count += 1
        self.tmpdir.cleanup()
        return count

