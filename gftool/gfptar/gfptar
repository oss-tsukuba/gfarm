             None, True),  # not Gfarm URL
            (self.D, 'dir1', 0o715, 2234567890, None, True),
        ]
        tree_readonly = [
            (self.D, 'dir1/readonly', 0o700,  # chmod 0o500 later
             3234567891, None, True),
            (self.F, 'dir1/readonly/file#2', 0o456, 4234567892, None, True),
