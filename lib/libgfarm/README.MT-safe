  - gfs_pio_pwrite
  - gfs_pio_write
  - gfs_pio_flush
  - gfs_pio_sync
  - gfs_pio_datasync
  - gfs_pio_truncate
  - gfs_pio_pread_page
  - gfs_pio_getc
  - gfs_pio_ungetc
