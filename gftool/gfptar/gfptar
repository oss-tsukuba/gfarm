    def list_tar_list_dbgz_from_dir(self, indir_url):
        PATT_TAR = r'^.*\.tar(\.\w{1,5})?$'  # *.tar or *.tar.*
        PATT_TAR_GEN1 = r'^(\d+)_.+'
        PATT_TAR_GEN_ALL = r'^g(\d+)_(\d+)_.+'
        tar_pattern = re.compile(PATT_TAR)
        tar_gen1_pattern = re.compile(PATT_TAR_GEN1)
        tar_gen_all_pattern = re.compile(PATT_TAR_GEN_ALL)
        dbgz_pattern = re.compile(InfoDB.PATT_DBGZ)
        tar_list = []
        dbgz_list = []
        for ent in indir_url.listdir(recursive=False):
            path = ent.path
            base = os.path.basename(path)
            db_match = dbgz_pattern.match(base)
            if db_match:
                gen = db_match.group(1)
                serial = db_match.group(2)
                # int("0001") -> 1
                dbgz_list.append((int(serial), int(gen), path))
                continue
            if ent.path.endswith(self.LIST_SUFFIX):  # ignore *.lst
                self.progress_newline()
                logger.warning(f"NOTICE: {ent.path}:"
                               " This file (*.lst) is no longer needed."
                               " Please remove it.")
                continue
            if not tar_pattern.match(base):  # ignore not *.tar.*
                continue
            t1_match = tar_gen1_pattern.match(base)
            if t1_match:
                # generation number = 1
                gen = '1'
                # ex. 0001 (str)
                serial = t1_match.group(1)
            else:
                t_match = tar_gen_all_pattern.match(base)
                if t_match:
                    gen = t_match.group(1)
                    # ex. 0001 (str)
                    serial = t_match.group(2)
                else:
                    # ignore irrelevant file
                    continue
            # int("0001") -> 1
            tar_list.append((int(serial), int(gen), path))
        return tar_list, dbgz_list

