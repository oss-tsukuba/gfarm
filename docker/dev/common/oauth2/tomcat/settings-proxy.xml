<settings>
  <proxies>
    <proxy>
      <id>http-proxy</id>
      <active>true</active>
      <protocol>http</protocol>
      <host>${env.GFDOCKER_PROXY_HOST}</host>
      <port>${env.GFDOCKER_PROXY_PORT}</port>
      <nonProxyHosts>${env.no_proxy}</nonProxyHosts>
    </proxy>

    <proxy>
      <id>https-proxy</id>
      <active>true</active>
      <protocol>https</protocol>
      <host>${env.GFDOCKER_PROXY_HOST}</host>
      <port>${env.GFDOCKER_PROXY_PORT}</port>
      <nonProxyHosts>${env.no_proxy}</nonProxyHosts>
    </proxy>
  </proxies>
</settings>